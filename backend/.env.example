# Port the Express server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# In local development this is usually the Vite dev server.
# In production this should be your deployed frontend URL(s).
CORS_ORIGIN=http://localhost:5173

# Maximum time (ms) to wait for the target site to respond before
# the audit request is aborted and a timeout error is returned.
FETCH_TIMEOUT_MS=8000

# Maximum size (bytes) of the response body we will download.
# Protects the server against extremely large pages.
MAX_CONTENT_LENGTH=5000000
